#!/bin/sh
# Strip unauthorized co-author, made-with, and assistant attribution. Human author only.
msg="$1"
tmp="${msg}.tmp"
grep -viE '^(Co-authored-by:|Co-Authored-By:|Made-with:|Made-With:)' "$msg" \
  | grep -viE 'cursoragent|@cursor\.com|^Cursor ' \
  | sed 's/[[:space:]]*$//' > "$tmp"
awk 'BEGIN{n=0} {lines[++n]=$0} END{while(n>0 && lines[n]=="") n--; for(i=1;i<=n;i++) print lines[i]}' "$tmp" > "$msg"
rm -f "$tmp"
